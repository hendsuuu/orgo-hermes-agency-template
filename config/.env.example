# Per-agent identity. Set by seed-agent.sh; never commit a populated file.
AGENCY_AGENT_ID=developer-01
AGENCY_ROLE=developer
AGENCY_TASK_BACKEND=notion

# Model: OpenRouter direct, no 9router.
OPENROUTER_API_KEY=
AGENCY_MODEL=anthropic/claude-sonnet-4

# Telegram: each agent has its own bot token, but uses the same agency group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
# Telegram user IDs allowed to create Assigned tasks with "/assign <agent-id> <title>".
TELEGRAM_PM_USER_IDS=

# Control-plane task interface (the adapter). The PM computer runs the service;
# workers call it and never receive the Notion token.
AGENCY_CONTROL_PLANE_TOKEN=          # shared bearer for worker <-> control-plane
AGENCY_PM_TOKEN=                     # optional: guards assign/create endpoints
AGENCY_CONTROL_PLANE_URL=            # workers only, e.g. https://pm-01.example:8787
AGENCY_SERVICE_HOST=0.0.0.0         # control-plane bind host
AGENCY_SERVICE_PORT=8787            # control-plane bind port
AGENCY_LEASE_TTL=900               # seconds; must exceed the longest task run
AGENCY_POLL_INTERVAL=60            # worker poll cadence (>=60 keeps Notion calm)
AGENCY_REAP_INTERVAL=120           # control-plane lease sweep cadence
# Command that runs the local Hermes agent headless on one task (workers only).
# It receives AGENCY_TASK_ID / AGENCY_TASK_FILE / AGENCY_TASK_BRIEF and should
# print a final JSON line: {"result_ref": "...", "tokens_used": N}.
AGENCY_EXECUTOR_CMD=

# Initial shared Kanban backend.
NOTION_API_KEY=
NOTION_TASKS_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=
NOTION_AGENTS_DATABASE_ID=

# Agent-private memory. Populate only for the configured Honcho deployment.
HONCHO_API_KEY=
HONCHO_BASE_URL=

# Composio dynamic MCP. The URL is a per-entity/tool-router endpoint.
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=

# Only the provisioner role receives this. Never give it to normal workers.
ORGO_API_KEY=
